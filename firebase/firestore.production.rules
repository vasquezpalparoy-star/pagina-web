rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{topLevel}/{document=**} {
      allow read, write: if request.auth != null
        && !(topLevel in ['deliveryAdmins','deliveryCustomers','deliveryOrders','deliveryOrderLinks','artifacts']);
    }
    match /artifacts/{artifact}/public/data/{collection}/{document=**} {
      allow read, write: if request.auth != null
        && !(artifact == 'grafiplot-tienda-v4' && collection in ['settings','faqs']);
    }
    function settingsOwner() {
      return request.auth != null
        && request.auth.uid == 'EUMQy18i2YTDZnuxIKda2DvPxU32'
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true;
    }
    match /artifacts/grafiplot-tienda-v4/public/data/settings/{document} {
      allow read: if true;
      allow create, update: if document == 'config' && settingsOwner();
      allow delete: if false;
    }
    match /artifacts/grafiplot-tienda-v4/public/data/faqs/{document} {
      allow read: if true;
      allow create, update: if settingsOwner();
      allow delete: if false;
    }
    function passwordAccount() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function registered() {
      return passwordAccount() && request.auth.token.email_verified == true;
    }
    function deliveryAdmin() {
      return registered()
        && exists(/databases/$(database)/documents/deliveryAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/deliveryAdmins/$(request.auth.uid)).data.enabled == true;
    }
    function validOrder(d) {
      return d.keys().hasAll(['customerUid','customerName','details','address','amount','deliveryFee','status','estimatedAt','createdAt','updatedAt','leftStoreAt','deliveredAt'])
        && d.keys().hasOnly(['customerUid','customerName','details','address','amount','deliveryFee','status','estimatedAt','createdAt','updatedAt','leftStoreAt','deliveredAt','trackingToken'])
        && (!('trackingToken' in d) || (d.trackingToken is string && d.trackingToken.matches('^[a-f0-9]{64}$')))
        && d.customerUid is string && d.customerUid.size() > 0
        && exists(/databases/$(database)/documents/deliveryCustomers/$(d.customerUid))
        && d.customerName is string && d.customerName.size() > 0 && d.customerName.size() <= 120
        && d.details is string && d.details.size() > 0 && d.details.size() <= 3000
        && d.address is string && d.address.size() > 0 && d.address.size() <= 500
        && d.amount is number && d.amount >= 0 && d.amount <= 100000
        && d.deliveryFee is number && d.deliveryFee >= 0 && d.deliveryFee <= 10000
        && d.status in ['recibido','en_proceso','listo','en_camino','entregado']
        && (d.estimatedAt == null || d.estimatedAt is timestamp)
        && d.createdAt is timestamp && d.updatedAt == request.time
        && ((d.status in ['en_camino','entregado'] && d.leftStoreAt is timestamp)
          || (d.status in ['recibido','en_proceso','listo'] && d.leftStoreAt == null))
        && ((d.status == 'entregado' && d.deliveredAt is timestamp)
          || (d.status != 'entregado' && d.deliveredAt == null));
    }
    function trackingMatches(d) {
      let o=getAfter(/databases/$(database)/documents/deliveryOrders/$(d.orderId)).data;
      return d.keys().hasAll(['orderId','details','amount','deliveryFee','status','estimatedAt','updatedAt','leftStoreAt','deliveredAt','expiresAt'])
        && d.keys().hasOnly(['orderId','details','amount','deliveryFee','status','estimatedAt','updatedAt','leftStoreAt','deliveredAt','expiresAt'])
        && d.expiresAt is timestamp && d.expiresAt <= request.time + duration.value(30, 'd')
        && d.details == o.details && d.amount == o.amount && d.deliveryFee == o.deliveryFee
        && d.status == o.status && d.estimatedAt == o.estimatedAt
        && d.updatedAt == o.updatedAt && d.leftStoreAt == o.leftStoreAt && d.deliveredAt == o.deliveredAt;
    }
    match /deliveryOrderLinks/{token} {
      allow get: if deliveryAdmin() || (token.matches('^[a-f0-9]{64}$')
        && resource.data.expiresAt > request.time
        && get(/databases/$(database)/documents/deliveryOrders/$(resource.data.orderId)).data.status != 'entregado'
        && get(/databases/$(database)/documents/deliveryOrders/$(resource.data.orderId)).data.trackingToken == token);
      allow list, delete: if false;
      allow create: if deliveryAdmin() && token.matches('^[a-f0-9]{64}$') && trackingMatches(request.resource.data)
        && getAfter(/databases/$(database)/documents/deliveryOrders/$(request.resource.data.orderId)).data.trackingToken == token;
      allow update: if deliveryAdmin() && request.resource.data.orderId == resource.data.orderId
        && (trackingMatches(request.resource.data) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expiresAt']) && request.resource.data.expiresAt <= request.time));
    }
    match /deliveryAdmins/{uid} {
      allow get: if passwordAccount() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /deliveryCustomers/{uid} {
      allow get: if deliveryAdmin() || (passwordAccount() && request.auth.uid == uid);
      allow list: if deliveryAdmin();
      allow create: if deliveryAdmin()
        && request.resource.data.keys().hasAll(['name','email','username','phone','createdAt'])
        && request.resource.data.keys().hasOnly(['name','email','username','phone','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 254 && request.resource.data.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && request.resource.data.username is string && request.resource.data.username.matches('^[a-z0-9][a-z0-9._-]{2,39}$')
        && request.resource.data.email == request.resource.data.username + '@delivery.grafiplotvasquez.com'
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /deliveryOrders/{orderId} {
      allow read: if deliveryAdmin() || (passwordAccount() && resource.data.customerUid == request.auth.uid
        && exists(/databases/$(database)/documents/deliveryCustomers/$(request.auth.uid)));
      allow create: if deliveryAdmin() && validOrder(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if deliveryAdmin() && validOrder(request.resource.data)
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
  }
}
